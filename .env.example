APP_ENV=development
APP_NAME=Duolarity AI ERP
API_V1_PREFIX=/api/v1

# ---- Database: SQLite works out of the box. Docker Compose switches to PostgreSQL automatically.
DATABASE_URL=sqlite:///./data/duolarity.db

# ---- Security (change SECRET_KEY for anything beyond local use)
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_REGISTRATION=true
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!@#

# ---- Storage
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_MB=200

# ---- Open-source AI via Ollama (https://ollama.com)  ->  ollama pull qwen2.5:7b-instruct
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Pick by RAM/VRAM: qwen2.5:3b-instruct (~3GB) | qwen2.5:7b-instruct (~6GB, recommended) | qwen2.5:14b-instruct | qwen2.5:32b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=300
AI_CHUNK_CHARS=7000
AI_CATEGORIZE_WITH_LLM=true
AI_FORCE_LLM_EXTRACTION=false

# ---- OCR for scanned PDFs / images (needs the Tesseract program installed)
OCR_ENABLED=true
OCR_DPI=200
